# Public env vars are inlined by Metro at build time (EXPO_PUBLIC_ prefix).
# Copy to .env.local and fill in. The Clerk key is the SAME publishable key the
# web app uses (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Development API base. Android emulator uses 10.0.2.2 to reach the host.
# For a physical device, use the development machine's LAN IP.
EXPO_PUBLIC_API_BASE=http://10.0.2.2:3000

# EAS production: override EXPO_PUBLIC_API_BASE with the real deployed API origin.
# Production EAS config intentionally fails if it is not set.

# Firebase Cloud Messaging (optional): provide a new google-services.json for
# com.scholarhub.app; never reuse a file registered for the old application ID.
# EAS may supply it through the file-type GOOGLE_SERVICES_JSON variable.
