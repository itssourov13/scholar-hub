# ScholarHub public deployment identity (set actual values before release)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# NVIDIA NIM (optional — admin parse/enrich "nim"/"kimi" model choices only)
NVIDIA_API_KEY=your_nim_api_key
NIM_MODEL=google/gemma-4-31b-it
NIM_FALLBACK_MODEL=
NIM_MODEL_LABEL=

# OpenRouter (chat / mentor + scholarship embeddings)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODEL=xiaomi/mimo-v2.5
# Photos / PDFs only — do not point this at Gemini (token cost).
OPENROUTER_VISION_MODEL=openai/gpt-5.6-luna
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Optional attribution headers (recommended)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ScholarHub

# Redis (rate limiting)
REDIS_URL=
REDIS_PREFIX=scholarhub

# Required when self-hosting Next.js (Railway). Vercel injects this automatically.
# Generate once with `openssl rand -base64 32` and keep it stable across deploys,
# otherwise Server Actions (Clerk, forms) fail for anyone on an older tab/PWA.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Analytics ───────────────────────────────────────────────────────────────
# Cloudflare Web Analytics beacon token (Cloudflare dashboard → Analytics &
# Logs → Web Analytics → your site → the `token` field in the snippet).
# Cookieless, so it is not gated behind the cookie consent banner.
# Leave unset to render no beacon at all.
NEXT_PUBLIC_SCHOLARHUB_CF_BEACON_TOKEN=

# ── Push notifications (FCM HTTP v1) ────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private
# key. Paste the whole JSON on one line, or base64-encode it (both accepted).
# Leave unset to disable push entirely — every send becomes a no-op.
FCM_SERVICE_ACCOUNT=
# Shared secret for the daily deadline-reminder job at /api/cron/push-digest.
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# ── Neon (replaces Supabase PostgreSQL) ─────────────────────────────────────
# Get this from the Neon console → your project → Connection string
DATABASE_URL=postgresql://username:password@hostname/database?sslmode=require

# ── Clerk (replaces Supabase Auth) ──────────────────────────────────────────
# Create an app at https://clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Webhook secret — set after creating a webhook endpoint in the Clerk dashboard
# pointing to: https://yourdomain.com/api/webhooks/clerk  (event: user.created)
CLERK_WEBHOOK_SECRET=whsec_xxx
# Optional: override default Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Cloudflare R2 (replaces Supabase Storage) ────────────────────────────────
# Get these from: Cloudflare Dashboard → R2 → your bucket → API tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=scholarhub-assets
# Public domain for the bucket (set under R2 bucket → Settings → Public Access)
# Set to the custom domain for the new ScholarHub asset bucket.
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=
